# cmake -DWEB_DIR=<web> -DOUT=<header> -P embed.cmake
# Gera um header com os arquivos do painel (index.html, app.js, app.css) como vetores de bytes. Só regrava o header
# se o conteúdo mudar (evita recompilar à toa).
set(names index.html app.js app.css)
set(paths /index.html /app.js /app.css)
# (sem ";" nos itens: listas do CMake usam ";" como separador; o charset entra no texto gerado)
set(mimes text/html text/javascript text/css)

set(body "// Gerado por server/admin/embed.cmake a partir de server/admin/web/. Não edite.\n")
string(APPEND body "#pragma once\n#include <cstddef>\n#include <string_view>\n\nnamespace cbadmin::web {\n\n")
string(APPEND body "struct File {\n  std::string_view path, mime;\n  const unsigned char* data;\n  size_t size;\n")
string(APPEND body "  std::string_view body() const { return {reinterpret_cast<const char*>(data), size}; }\n};\n\n")
set(table "")
list(LENGTH names n)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  list(GET names ${i} name)
  list(GET paths ${i} path)
  list(GET mimes ${i} mime)
  file(READ "${WEB_DIR}/${name}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  # quebra de linha a cada 32 bytes (linhas curtas para o compilador e para diffs)
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n  " arr "${arr}")
  string(APPEND body "inline const unsigned char kData${i}[] = {\n  ${arr}0x00};\n\n")
  string(APPEND table "    File{\"${path}\", \"${mime}; charset=utf-8\", kData${i}, ${size}},\n")
endforeach()
string(APPEND body "inline const File kFiles[] = {\n${table}};\n\n}  // namespace cbadmin::web\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
