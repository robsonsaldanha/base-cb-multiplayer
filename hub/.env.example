# Porta e endereço de escuta (atrás do nginx em produção)
HUB_PORT=8787
HUB_HOST=127.0.0.1
# URL pública (usada no redirect do Discord e na checagem de Origin do painel)
HUB_PUBLIC_URL=http://localhost:8787
HUB_DATA_DIR=./data
# App Discord: https://discord.com/developers/applications → OAuth2
# Redirect: <HUB_PUBLIC_URL>/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord IDs dos administradores da plataforma (bans globais), separados por vírgula
HUB_PLATFORM_ADMINS=
# 1 = permite /v1/auth/dev-login (somente com HUB_HOST=127.0.0.1, para testes sem Discord)
HUB_DEV_LOGIN=0
# Proxies confiáveis (lista de IPs/CIDRs separados por vírgula), ex. 127.0.0.1,::1 quando atrás do nginx. Vazio = não confiar em X-Forwarded-For. "1" é recusado.
HUB_TRUST_PROXY=
# 1 = permite listar servidores em IPs privados/locais (só para testes locais)
HUB_ALLOW_PRIVATE_SERVERS=0
HUB_RATE_LIMIT=1
HUB_LOG_LEVEL=info
# Releases do repo privado (updates do launcher, mod, /v1/dl). Vazio = rotas respondem 503 updates_disabled.
# Token fine-grained com só Contents: read no repo. Nunca é logado.
HUB_GITHUB_TOKEN=
# dono/repo (obrigatório quando há token)
HUB_RELEASES_REPO=
# Downloads de /v1/dl ao mesmo tempo (todos os clientes; cada IP tem no máximo 2)
HUB_DL_MAX_CONCURRENT=32
