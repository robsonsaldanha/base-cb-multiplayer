 */
 
 
+/*
+** cbmp patch: interrupt request. 'lua_cbmp_setinterrupt' may be called from
+** any OS thread (it only reads the immutable 'l_G' and stores the flag); the
+** VM polls the flag at calls, returns and jumps, and libraries poll it in long
+** C loops with 'lua_cbmp_poll' (Lua thread only).
+*/
+LUA_API void lua_cbmp_setinterrupt (lua_State *L, int on) {
+  G(L)->cbmp_interrupt = on;
+}
+
+
+LUA_API void lua_cbmp_poll (lua_State *L) {
+  if (l_unlikely(G(L)->cbmp_interrupt))
+    luaE_cbmpinterrupt(L);
+}
