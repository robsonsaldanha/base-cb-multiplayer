+/*
+** cbmp patch: the host keeps, in the extra space of every thread, a pointer to
+** 'struct { void (*check) (lua_State *L); }' (or NULL). 'check' runs on the Lua
+** thread when an interrupt is pending; it may raise an error (timeout) or clear
+** the request with 'lua_cbmp_setinterrupt(L, 0)'.
+*/
+void luaE_cbmpinterrupt (lua_State *L) {
+  typedef struct { void (*check) (lua_State *L); } cbmp_interrupt_cb;
+  const cbmp_interrupt_cb *cb = *(const cbmp_interrupt_cb **)lua_getextraspace(L);
+  if (cb != NULL && cb->check != NULL)
+    cb->check(L);
+  else
+    G(L)->cbmp_interrupt = 0;  /* nobody to handle it */
+}
