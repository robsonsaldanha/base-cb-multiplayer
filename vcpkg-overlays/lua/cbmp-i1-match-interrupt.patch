cbmp: periodic host interrupt check in lstrlib match() (pattern backtracking),
and zeroed extra space for the main thread (lua_newstate) so the check pointer starts NULL.
Against Lua 5.4.7. Re-check on upgrade: MatchState, match(), prepstate in lstrlib.c; lua_newstate in lstate.c.

--- a/src/lstate.c
+++ b/src/lstate.c
@@ -369,6 +369,9 @@
   g->currentwhite = bitmask(WHITE0BIT);
   L->marked = luaC_white(g);
   preinit_thread(L, g);
+  /* cbmp patch (I1): the main thread's extra space starts zeroed (no interrupt
+  ** callback); new threads copy it from the main thread. */
+  memset(lua_getextraspace(L), 0, LUA_EXTRASPACE);
   g->allgc = obj2gco(L);  /* by now, only object is the main thread */
   L->next = NULL;
   incnny(L);  /* main thread is always non yieldable */
--- a/src/lstrlib.c
+++ b/src/lstrlib.c
@@ -361,6 +361,7 @@
   const char *p_end;  /* end ('\0') of pattern */
   lua_State *L;
   int matchdepth;  /* control for recursive depth (to avoid C stack overflow) */
+  unsigned int cbmp_steps;  /* cbmp patch: steps since last interrupt check */
   unsigned char level;  /* total number of captures (finished or unfinished) */
   struct {
     const char *init;
@@ -373,6 +374,24 @@
 static const char *match (MatchState *ms, const char *s, const char *p);
 
 
+/*
+** cbmp patch (Lua 5.4.7, I1): pattern matching can run for minutes inside C
+** (catastrophic backtracking), out of reach of count/call hooks. Every
+** CBMP_MATCH_CHECK steps, call the host's interrupt check. The host stores in
+** the thread's extra space (copied from the main thread by lua_newthread) a
+** pointer to a 'struct cbmp_interrupt' (or NULL); 'check' may raise a Lua error.
+*/
+#define CBMP_MATCH_CHECK	4096u
+struct cbmp_interrupt { void (*check) (lua_State *L); };
+
+static void cbmp_checkinterrupt (lua_State *L) {
+  const struct cbmp_interrupt *it =
+      *(const struct cbmp_interrupt **)lua_getextraspace(L);
+  if (it != NULL && it->check != NULL)
+    it->check(L);
+}
+
+
 /* maximum recursion depth for 'match' */
 #if !defined(MAXCCALLS)
 #define MAXCCALLS	200
@@ -571,6 +590,10 @@
   if (l_unlikely(ms->matchdepth-- == 0))
     luaL_error(ms->L, "pattern too complex");
   init: /* using goto to optimize tail recursion */
+  if (l_unlikely(++ms->cbmp_steps >= CBMP_MATCH_CHECK)) {  /* cbmp patch */
+    ms->cbmp_steps = 0;
+    cbmp_checkinterrupt(ms->L);
+  }
   if (p != ms->p_end) {  /* end of pattern? */
     switch (*p) {
       case '(': {  /* start capture */
@@ -758,6 +781,7 @@
                        const char *s, size_t ls, const char *p, size_t lp) {
   ms->L = L;
   ms->matchdepth = MAXCCALLS;
+  ms->cbmp_steps = 0;  /* cbmp patch */
   ms->src_init = s;
   ms->src_end = s + ls;
   ms->p_end = p + lp;
