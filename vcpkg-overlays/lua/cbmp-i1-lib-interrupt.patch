 static const char *match (MatchState *ms, const char *s, const char *p);
 
 
+/*
+** cbmp patch: matching can run for minutes inside C (backtracking, long
+** classes, '%b', naive substring search). Count work (1 per step, plus 1 per
+** 4 KiB of pattern/needle scanned) and poll the host interrupt request every
+** CBMP_STEPS units.
+*/
+#define CBMP_STEPS	4096u
+
+static void cbmp_tick (lua_State *L, unsigned int *steps, size_t work) {
+  size_t w = 1 + (work >> 12);
+  if (w >= CBMP_STEPS - *steps) {
+    *steps = 0;
+    lua_cbmp_poll(L);
+  }
+  else
+    *steps += (unsigned int)w;
+}
+
+
