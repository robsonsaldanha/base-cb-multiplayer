# Hub do ambiente de TESTE online. Sem segredos: o app Discord fica em /etc/cbmp-teste/discord.env (criado pelo dono).
# Instalado em /var/www/html_cbmultiplayer/hub.env por tools/teste-online/remote-install.sh.
HUB_PORT=8787
HUB_HOST=127.0.0.1
HUB_PUBLIC_URL=https://cbmultiplayer.cntoficial.com.br
HUB_DATA_DIR=/var/www/html_cbmultiplayer/hub-data
# Hub de teste público: releases locais assinadas (HUB_RELEASES_DIR) e sobe sem o app Discord.
HUB_STAGING=1
HUB_RELEASES_DIR=/var/www/html_cbmultiplayer/releases
# Só o nginx local é proxy confiável; o nginx já troca o IP da Cloudflare pelo do visitante (CF-Connecting-IP,
# snippets/cloudflare-real-ip.conf) e manda X-Forwarded-For com ele.
HUB_TRUST_PROXY=127.0.0.1
HUB_ALLOW_PRIVATE_SERVERS=0
HUB_RATE_LIMIT=1
HUB_LOG_LEVEL=info
HUB_DEV_LOGIN=0
